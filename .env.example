# Copy to Vercel → Project → Settings → Environment Variables (Production + Preview)

# Supabase (Project → Settings → API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # service_role, never the anon key; never ship to the browser

# Resend (resend.com → API Keys). Until fountainbuild.com is verified in Resend, keep the sandbox sender.
RESEND_API_KEY=re_...
FROM_EMAIL=FOUNTAIN <onboarding@resend.dev>  # after domain verify: FOUNTAIN <hello@fountainbuild.com>

# Who gets notified
TEAM_RECIPIENTS=tree@fountainbuild.ai,miki@fountainbuild.ai
APPLY_RECIPIENTS=apply@fountainbuild.ai      # optional; falls back to TEAM_RECIPIENTS

SITE_URL=https://fountainbuild.com
