{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/eden", "destination": "/eden-factory.html" },
    { "source": "/data", "destination": "/data-network.html" },
    { "source": "/nora-memo", "destination": "/nora-memo.html" }
  ],
  "headers": [
    { "source": "/api/(.*)", "headers": [
      { "key": "Cache-Control", "value": "no-store" }
    ] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
